// use prisma-8

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  emailVerified Boolean
  passwordHash  String
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @onCreate(now()) @onUpdate(now())
}

enum Role {
  USER
  ADMIN
}
