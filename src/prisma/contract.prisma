// use prisma-8

model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  passwordHash  String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @onCreate(now()) @onUpdate(now())
}

model UserIdentity {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @unique
  subject   String   @unique
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model Sessions {
  id           String   @id
  userId       String   @map("user_id")
  createdAt    TimestamptzJsDate(6) @map("created_at")
  expiresAt    TimestamptzJsDate(6) @map("expires_at")
  lastActiveAt TimestamptzJsDate(6) @map("last_active_at")
  mfa          Mfa?
  metadata     Jsonb?

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model RefreshTokens {
  id              String    @id
  familyId        String    @map("family_id")
  userId          String    @map("user_id")
  createdAt       TimestamptzJsDate(6)  @map("created_at")
  expiresAt       TimestamptzJsDate(6)  @map("expires_at")
  familyExpiresAt TimestamptzJsDate(6)  @map("family_expires_at")
  usedAt          TimestamptzJsDate(6)? @map("used_at")
  revoked         Boolean   @default(false)
  claims          Jsonb?

  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([familyExpiresAt], map: "refresh_tokens_family_expires_at_idx")
  @@map("refresh_tokens")
}

model MfaAuthenticators {
  userId        String  @id @map("user_id")
  secret        String
  confirmed     Boolean
  pendingSecret String? @map("pending_secret")
  lastUsedStep  Int?    @map("last_used_step")

  @@map("mfa_authenticators")
}

model MfaRecoveryCodes {
  userId   String @map("user_id")
  codeHash String @map("code_hash")

  @@id([userId, codeHash])
  @@map("mfa_recovery_codes")
}

model MfaFailures {
  id       Int      @id @default(autoincrement())
  userId   String   @map("user_id")
  failedAt TimestamptzJsDate(6) @map("failed_at")

  @@index([userId, failedAt], map: "mfa_failures_user_id_failed_at_idx")
  @@index([failedAt], map: "mfa_failures_failed_at_idx")
  @@map("mfa_failures")
}

model MagicLinks {
  id         String   @id
  email      String
  createdAt  TimestamptzJsDate(6) @map("created_at")
  expiresAt  TimestamptzJsDate(6) @map("expires_at")
  redirectTo String?  @map("redirect_to")

  @@index([expiresAt], map: "magic_links_expires_at_idx")
  @@map("magic_links")
}

model OidcLogins {
  state         String   @id
  provider      String
  codeVerifier  String   @map("code_verifier")
  nonce         String?
  redirectTo    String?  @map("redirect_to")
  linkUserId    String?  @map("link_user_id")
  linkSessionId String?  @map("link_session_id")
  createdAt     TimestamptzJsDate(6) @map("created_at")
  expiresAt     TimestamptzJsDate(6) @map("expires_at")

  @@index([expiresAt], map: "oidc_logins_expires_at_idx")
  @@map("oidc_logins")
}

model EmailTokens {
  id          String   @id
  purpose     Purpose
  userId      String   @map("user_id")
  email       String
  fingerprint String?
  createdAt   TimestamptzJsDate(6) @map("created_at")
  expiresAt   TimestamptzJsDate(6) @map("expires_at")

  @@index([userId, purpose], map: "email_tokens_user_id_purpose_idx")
  @@index([expiresAt], map: "email_tokens_expires_at_idx")
  @@map("email_tokens")
}

enum Purpose {
  password-reset
  email-verification
}

enum Mfa {
  pending
  verified
}

enum Role {
  USER
  ADMIN
}
